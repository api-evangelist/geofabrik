  "info": {
    "_postman_id": "1a4e496c-8798-4e63-bb1d-06d3be20130b",
    "name": "Geofabrik Download Downloads API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Free download service providing daily-updated OpenStreetMap (OSM) data extracts by geographic region. A machine-readable JSON index lets clients programmatically discover all available extracts and their download URLs. Data are distributed under the ODbL 1.0 license.\n\n\nContact Support:\n Name: Geofabrik GmbH",
      "type": "text/plain"
    }
