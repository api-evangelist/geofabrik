        {
          "id": "b96a7b58-82bc-438d-a22b-173bf7d1389b",
          "name": "Download latest OSM PBF extract",
          "request": {
            "name": "Download latest OSM PBF extract",
            "description": {
              "content": "Downloads the latest daily-updated OSM extract for the specified region/area in PBF (Protocol Buffer) binary format. The exact URL for each area is available from the index endpoint (urls.pbf).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":region",
                "{{area}}-latest.osm.pbf"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "region",
                  "description": "(Required) Top-level geographic region, e.g. europe, north-america, asia, australia-oceania, africa, south-america, central-america, russia, antarctica.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/octet-stream"
              }
            ],
            "method": "GET",
            "auth": null
